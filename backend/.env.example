# Copy to backend/.env and fill in. backend/.env is git-ignored; never commit a key.

# Who plays the suspects: ollama (local model, free, the default), claude (needs
# ANTHROPIC_API_KEY, pay as you go) or mock (scripted, no setup). --ai overrides this.
# CASEFILE_AI=ollama

# Ollama: install from ollama.com, then `ollama pull llama3.1:8b`
# CASEFILE_OLLAMA_URL=http://localhost:11434
# CASEFILE_OLLAMA_MODEL=llama3.1:8b

# Claude
ANTHROPIC_API_KEY=
# CASEFILE_CLAUDE_MODEL=claude-opus-5-5
# CASEFILE_EFFORT=low

# Every provider
# CASEFILE_MAX_OUTPUT_TOKENS=2048
# CASEFILE_SESSION_TOKEN_BUDGET=400000          # Claude: a cost cap per game
# CASEFILE_LOCAL_SESSION_TOKEN_BUDGET=2000000   # Ollama: free, but still capped
# CASEFILE_REQUEST_TIMEOUT_S=120

# API server (uv run casefile-api)
# CASEFILE_MAX_GAMES=200
# CASEFILE_GAME_IDLE_MINUTES=120
# Saved games (D53). Leave CASEFILE_SAVE_FILE empty to keep games in memory only.
# CASEFILE_SAVE_FILE=games.sqlite3
# CASEFILE_KEEP_SAVES_DAYS=30
# Public server: Claude plays on each player's own key, sent with each question and
# never stored (D58). The server then needs no ANTHROPIC_API_KEY.
# CASEFILE_PLAYER_KEYS=false

# Rate limits per visitor (D57)
# CASEFILE_NEW_GAMES_PER_HOUR=30
# CASEFILE_MOVES_PER_MINUTE=120
# Set true on a host with a proxy in front (Render), so the limits see the visitor
# CASEFILE_BEHIND_PROXY=false
# Also serve the built web game (same as --web)
# CASEFILE_WEB_DIR=../frontend/dist
