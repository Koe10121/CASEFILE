# Copy to backend/.env and fill in. backend/.env is git-ignored; never commit a key.

# Who plays the suspects: mock (scripted, no setup), ollama (local model, free) or
# claude (needs ANTHROPIC_API_KEY, pay as you go). The --ai flag overrides this.
# CASEFILE_AI=mock

# Ollama: install from ollama.com, then `ollama pull llama3.1:8b`
# CASEFILE_OLLAMA_URL=http://localhost:11434
# CASEFILE_OLLAMA_MODEL=llama3.1:8b

# Claude
ANTHROPIC_API_KEY=
# CASEFILE_CLAUDE_MODEL=claude-opus-5-5
# CASEFILE_EFFORT=low

# Every provider
# CASEFILE_MAX_OUTPUT_TOKENS=2048
# CASEFILE_SESSION_TOKEN_BUDGET=400000
# CASEFILE_REQUEST_TIMEOUT_S=120
