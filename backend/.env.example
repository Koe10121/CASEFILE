# Copy to backend/.env and fill in. backend/.env is git-ignored; never commit a key.

# Needed only for Claude mode (`uv run casefile --claude`). Mock mode needs nothing.
ANTHROPIC_API_KEY=

# Optional overrides (defaults shown)
# CASEFILE_MODEL=claude-opus-5-5
# CASEFILE_EFFORT=low
# CASEFILE_MAX_OUTPUT_TOKENS=2048
# CASEFILE_SESSION_TOKEN_BUDGET=400000
# CASEFILE_REQUEST_TIMEOUT_S=60
