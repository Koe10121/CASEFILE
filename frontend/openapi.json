  "components": {
    "schemas": {
      "Accusation": {
        "properties": {
          "culprit": {
            "type": "string",
            "pattern": "^S_[A-Z0-9]+(?:_[A-Z0-9]+)*$",
            "title": "Culprit"
          },
          "motive": {
            "type": "string",
            "pattern": "^MOT_[A-Z0-9]+(?:_[A-Z0-9]+)*$",
            "title": "Motive"
          },
          "method": {
            "type": "string",
            "pattern": "^MTH_[A-Z0-9]+(?:_[A-Z0-9]+)*$",
            "title": "Method"
          },
          "evidence": {
            "items": {
              "type": "string",
              "pattern": "^E\\d{2}$"
            },
            "type": "array",
            "title": "Evidence"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "culprit",
          "motive",
          "method",
          "evidence"
        ],
        "title": "Accusation",
        "description": "The player's structured, final accusation."
      },
      "AccusationOptionsOut": {
        "properties": {
          "culprits": {
            "items": {
              "type": "string",
              "pattern": "^S_[A-Z0-9]+(?:_[A-Z0-9]+)*$"
            },
            "type": "array",
            "title": "Culprits"
          },
          "motives": {
            "items": {
              "$ref": "#/components/schemas/OptionOut"
            },
            "type": "array",
            "title": "Motives"
          },
          "methods": {
            "items": {
              "$ref": "#/components/schemas/OptionOut"
            },
            "type": "array",
            "title": "Methods"
          },
          "max_evidence": {
            "type": "integer",
            "title": "Max Evidence"
          }
        },
        "type": "object",
        "required": [
          "culprits",
          "motives",
          "methods",
          "max_evidence"
        ],
        "title": "AccusationOptionsOut"
      },
      "AccusationScoredOut": {
        "properties": {
          "type": {
            "type": "string",
            "const": "accusation_scored",
            "title": "Type",
            "default": "accusation_scored"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          }
        },
        "type": "object",
        "required": [
          "total"
        ],
        "title": "AccusationScoredOut"
      },
      "AccuseRequest": {
        "properties": {
          "accusation": {
            "$ref": "#/components/schemas/Accusation"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "accusation"
        ],
        "title": "AccuseRequest"
      },
      "ActionOut": {
        "properties": {
          "line": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/LineOut"
              },
              {
                "type": "null"
              }
            ]
          },
          "events": {
            "items": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/FactLearnedOut"
                },
                {
                  "$ref": "#/components/schemas/EvidenceFoundOut"
                },
                {
                  "$ref": "#/components/schemas/LocationSearchedOut"
                },
                {
                  "$ref": "#/components/schemas/LieOnRecordOut"
                },
                {
                  "$ref": "#/components/schemas/LieCaughtOut"
                },
                {
                  "$ref": "#/components/schemas/AccusationScoredOut"
                }
              ],
              "discriminator": {
                "propertyName": "type",
                "mapping": {
                  "accusation_scored": "#/components/schemas/AccusationScoredOut",
                  "evidence_found": "#/components/schemas/EvidenceFoundOut",
                  "fact_learned": "#/components/schemas/FactLearnedOut",
                  "lie_caught": "#/components/schemas/LieCaughtOut",
                  "lie_on_record": "#/components/schemas/LieOnRecordOut",
                  "location_searched": "#/components/schemas/LocationSearchedOut"
                }
              }
            },
            "type": "array",
            "title": "Events"
          },
          "game": {
            "$ref": "#/components/schemas/GameOut"
          }
        },
        "type": "object",
        "required": [
          "line",
          "events",
          "game"
        ],
        "title": "ActionOut"
      },
      "AskRequest": {
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "title": "Text"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "text"
        ],
        "title": "AskRequest"
      },
      "CaseOut": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "place": {
            "type": "string",
            "title": "Place"
          },
          "date": {
            "type": "string",
            "title": "Date"
          },
          "intro": {
            "type": "string",
            "title": "Intro"
          },
          "detective": {
            "$ref": "#/components/schemas/DetectiveOut"
          },
          "people": {
            "items": {
              "$ref": "#/components/schemas/PersonOut"
            },
            "type": "array",
            "title": "People"
          },
          "accusation": {
            "$ref": "#/components/schemas/AccusationOptionsOut"
          },
          "ai": {
            "type": "string",
            "title": "Ai"
          },
          "max_question_chars": {
            "type": "integer",
            "title": "Max Question Chars"
          }
        },
        "type": "object",
        "required": [
          "id",
          "title",
          "place",
          "date",
          "intro",
          "detective",
          "people",
          "accusation",
          "ai",
          "max_question_chars"
        ],
        "title": "CaseOut",
        "description": "What the case file's cover shows. The same for every game of this case."
      },
      "DetectiveOut": {
        "properties": {
          "callsign": {
            "type": "string",
            "title": "Callsign"
          },
          "identities": {
            "items": {
              "$ref": "#/components/schemas/IdentityOut"
            },
            "type": "array",
            "title": "Identities"
          }
        },
        "type": "object",
        "required": [
          "callsign",
          "identities"
        ],
        "title": "DetectiveOut"
      },
      "DifficultyProfile": {
        "properties": {
          "contradictions": {
            "type": "string",
            "enum": [
              "auto_flag",
              "side_by_side",
              "off"
            ],
            "title": "Contradictions"
          },
          "hints": {
            "type": "string",
            "pattern": "^(none|auto_after_minutes:[1-9]\\d*|on_request:[1-9]\\d*)$",
            "title": "Hints"
          },
          "notebook": {
            "type": "string",
            "enum": [
              "by_suspect_and_time",
              "by_suspect",
              "flat"
            ],
            "title": "Notebook"
          },
          "evidence_picker": {
            "type": "string",
            "enum": [
              "relevant_only",
              "all_found"
            ],
            "title": "Evidence Picker"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "contradictions",
          "hints",
          "notebook",
          "evidence_picker"
        ],
        "title": "DifficultyProfile",
        "description": "Difficulty changes only the help the player gets, never the truth (D11)."
      },
      "ErrorOut": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
